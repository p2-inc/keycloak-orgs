<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

    <!--
      USER_ORGANIZATION_ROLE_MAPPING.ROLE_ID was created as VARCHAR(255) (20200424) while the
      column it references, ORGANIZATION_ROLE.ID, is VARCHAR(36) (20211207). The 20211206
      changeSets aligned it to VARCHAR(36), but only on MSSQL, where the FK cannot be created
      otherwise. MySQL and MariaDB accept the mismatch, and on those the column is still 255.

      On MySQL Group Replication / InnoDB Cluster the mismatch breaks the secondaries. The
      parallel applier orders dependent transactions using write-set hashes. The parent's PK
      hash is built from ORGANIZATION_ROLE.ID normalized to 36 characters, and the child's
      foreign key hash from ROLE_ID normalized to 255, so the two never match
      (sql/rpl_write_set_handler.cc). The certifier assigns last_committed from those hashes
      alone (plugin/group_replication/src/certifier.cc), so creating an organization role and
      assigning it to a user in quick succession produces two transactions the secondary
      considers independent. When a worker applies the mapping before the role has committed,
      the secondary fails with error 1452 on FK_123g9nf5findslfksadifu277, stops its applier
      and leaves the group.

      MySQL refuses to change the type of a column used in a foreign key
      (ERROR 1832), so the constraint is dropped and recreated around the change, with the
      same definition as in 20211207. The preconditions skip databases already at 36.
    -->

    <changeSet author="ElfoLiNk" id="align-USER_ORGANIZATION_ROLE_MAPPING-ROLE_ID-to-VARCHAR-36-mysql">
        <preConditions onFail="MARK_RAN">
            <or>
                <dbms type="mysql"/>
                <dbms type="mariadb"/>
            </or>
            <foreignKeyConstraintExists foreignKeyTableName="USER_ORGANIZATION_ROLE_MAPPING" foreignKeyName="FK_123g9nf5findslfksadifu277"/>
            <sqlCheck expectedResult="1">
                SELECT COUNT(*) FROM information_schema.COLUMNS
                WHERE TABLE_SCHEMA = DATABASE()
                  AND UPPER(TABLE_NAME) = 'USER_ORGANIZATION_ROLE_MAPPING'
                  AND UPPER(COLUMN_NAME) = 'ROLE_ID'
                  AND CHARACTER_MAXIMUM_LENGTH &lt;&gt; 36
            </sqlCheck>
        </preConditions>
        <dropForeignKeyConstraint baseTableName="USER_ORGANIZATION_ROLE_MAPPING" constraintName="FK_123g9nf5findslfksadifu277"/>
        <modifyDataType tableName="USER_ORGANIZATION_ROLE_MAPPING" columnName="ROLE_ID" newDataType="VARCHAR(36)"/>
        <addNotNullConstraint tableName="USER_ORGANIZATION_ROLE_MAPPING" columnName="ROLE_ID" columnDataType="VARCHAR(36)"/>
        <addForeignKeyConstraint baseColumnNames="ROLE_ID" baseTableName="USER_ORGANIZATION_ROLE_MAPPING" constraintName="FK_123g9nf5findslfksadifu277" deferrable="false" initiallyDeferred="false" referencedColumnNames="ID" referencedTableName="ORGANIZATION_ROLE"/>
    </changeSet>

</databaseChangeLog>
